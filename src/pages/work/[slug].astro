---
import { render } from 'astro:content';
import ArrowLink from '../../components/ArrowLink.astro';
import Button from '../../components/Button.astro';
import ConceptTag from '../../components/ConceptTag.astro';
import Screen from '../../components/Screen.astro';
import ScreenPair from '../../components/ScreenPair.astro';
import StackTags from '../../components/StackTags.astro';
import StatusLine from '../../components/StatusLine.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies, metaLine, type CaseStudy } from '../../lib/case-studies';

export async function getStaticPaths() {
  const entries = await getCaseStudies();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const facts = [
  { term: 'Client', value: data.client },
  { term: 'Industry', value: data.industry },
  { term: 'City', value: data.city },
  { term: 'Year', value: data.year },
  { term: 'Type', value: data.kind === 'concept' ? 'Concept project' : 'Client project' },
].filter((fact) => fact.value);

const summary = [
  { term: 'The problem', value: data.problem },
  { term: 'What we built', value: data.built },
  { term: 'The result', value: data.result },
];

// Two [PLACEHOLDER] slots keep the gallery's shape until real screens exist.
const gallery = data.gallery.length > 0 ? data.gallery : [undefined, undefined];
---

<BaseLayout title={data.client} description={`${data.client}: ${data.built}`} noindex={data.placeholder}>
  <article class="case-study">
    <header class="pt-nav">
      <div class="shell pt-8 pb-12 sm:pt-12 sm:pb-16">
        <ArrowLink href="/#work" arrow="←" class="text-sm">All work</ArrowLink>

        <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2">
          {data.kind === 'concept' && <ConceptTag />}
          <p class="label text-muted">{metaLine(data)}</p>
        </div>
        <h1 class="mt-4 max-w-4xl text-display font-semibold text-balance">{data.client}</h1>
        <p class="mt-6 max-w-2xl text-lg text-pretty text-muted sm:text-xl">{data.built}</p>

        <div class="bg-grid mt-12 border border-ink p-5 sm:p-10 lg:p-16">
          <div class="mx-auto max-w-4xl">
            <ScreenPair screens={data.screens} lgWidth="min(80vw, 896px)" loading="eager" />
          </div>
        </div>
      </div>
    </header>

    <div class="shell pb-20 sm:pb-28">
      <section aria-labelledby="overview" class="case-section">
        <h2 id="overview">Overview</h2>
        <div class="mt-8 grid gap-10 lg:grid-cols-12">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 self-start lg:col-span-4">
            {
              facts.map((fact) => (
                <div>
                  <dt class="label text-muted">{fact.term}</dt>
                  <dd class="mt-1">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <dl class="divide-y divide-hairline border-y border-hairline lg:col-span-8">
            {
              summary.map((item) => (
                <div class="grid gap-1.5 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
                  <dt class="label pt-1 text-muted">{item.term}</dt>
                  <dd class="text-lg text-pretty">{item.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Markdown body: ## The problem, ## Our approach, ## The build -->
      <div class="case-body">
        <Content />
      </div>

      <section aria-labelledby="screens" class="case-section">
        <h2 id="screens">Screens</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            gallery.map((shot, i) => (
              <figure>
                <div class="border border-hairline">
                  <Screen
                    image={shot}
                    placeholder="[PLACEHOLDER screen]"
                    sizes="(min-width: 1280px) 600px, (min-width: 640px) 45vw, 90vw"
                  />
                </div>
                <figcaption class="label mt-3 text-muted">
                  Fig. {String(i + 1).padStart(2, '0')}
                  {shot?.caption && <span class="text-ink"> — {shot.caption}</span>}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="result" class="case-section">
        <h2 id="result">Result</h2>
        <p class="mt-8 flex max-w-3xl items-baseline gap-4 text-h3 font-medium text-pretty">
          <span class="size-2 shrink-0 -translate-y-1 rounded-full bg-signal" aria-hidden="true"></span>
          {data.result}
        </p>
      </section>

      <section aria-labelledby="stack" class="case-section">
        <h2 id="stack">Stack</h2>
        <StackTags stack={data.stack} class="mt-8" />
      </section>

      <div class="bg-grid mt-20 flex flex-col items-start gap-6 border border-ink p-6 sm:mt-28 sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <StatusLine />
        <Button href="/start" size="lg">Start a similar project</Button>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  /* Every h2 in the article, from the template or the markdown body, gets the
     next specimen number: TD—01, TD—02, ... */
  .case-study {
    counter-reset: case-section;
  }

  .case-section,
  .case-body :global(h2) {
    @apply mt-20 border-t border-hairline pt-12 sm:mt-28 sm:pt-16;
  }

  .case-study :global(h2) {
    @apply text-h2 font-semibold text-balance;
    counter-increment: case-section;
  }

  .case-study :global(h2)::before {
    @apply label mb-4 block text-muted;
    content: 'TD—' counter(case-section, decimal-leading-zero) / '';
  }

  /* Long-form markdown */
  .case-body :global(:is(p, ul, ol, h3, blockquote)) {
    @apply max-w-3xl;
  }

  .case-body :global(p),
  .case-body :global(ul),
  .case-body :global(ol) {
    @apply mt-5 text-lg leading-relaxed text-pretty;
  }

  .case-body :global(h2 + p) {
    @apply mt-8;
  }

  .case-body :global(h3) {
    @apply mt-10 text-h3 font-semibold;
  }

  .case-body :global(ul) {
    @apply list-disc pl-5 marker:text-muted;
  }

  .case-body :global(ol) {
    @apply list-decimal pl-5 marker:font-mono marker:text-sm marker:text-muted;
  }

  .case-body :global(li + li) {
    @apply mt-2;
  }

  .case-body :global(strong) {
    @apply font-semibold;
  }

  .case-body :global(a) {
    @apply underline decoration-signal decoration-1 underline-offset-4;
  }

  .case-body :global(blockquote) {
    @apply mt-8 border-l border-ink pl-6 text-h3 font-medium;
  }
</style>
