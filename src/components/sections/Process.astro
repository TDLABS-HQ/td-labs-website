---
import SectionLabel from '../SectionLabel.astro';

// [PLACEHOLDER] "[30]" days of free fixes is unconfirmed.
const steps = [
  {
    title: 'Discovery',
    duration: '~1 WEEK',
    body: 'We learn your business, your customers, and the real problem.',
    deliverable: 'a clear scope and a fixed quote',
  },
  {
    title: 'Design',
    duration: '1–2 WEEKS',
    body: 'We design the key screens before writing any code. You approve before we build.',
    deliverable: 'clickable designs',
  },
  {
    title: 'Build',
    duration: '2–8 WEEKS',
    body: 'We develop your project in milestones. You see progress as it happens.',
    deliverable: 'a live preview link',
  },
  {
    title: 'Launch',
    duration: 'ONGOING',
    body: 'We deploy, train your team, and hand everything over.',
    deliverable: 'your live product + [30] days of free fixes',
  },
];

// Sample data for the portal mock (illustrative, not a real project).
type Status = 'done' | 'progress' | 'next';
const milestones: { name: string; status: Status; percent: number }[] = [
  { name: 'Discovery', status: 'done', percent: 100 },
  { name: 'Design', status: 'done', percent: 100 },
  { name: 'Build', status: 'progress', percent: 60 },
  { name: 'Launch', status: 'next', percent: 0 },
];
const overall = Math.round(milestones.reduce((sum, m) => sum + m.percent, 0) / milestones.length);
const files = ['scope.pdf', 'designs-v2.fig', 'preview-link.txt'];
---

<section id="process" aria-labelledby="process-heading" class="border-b border-hairline py-20 sm:py-28">
  <div class="shell">
    <div data-reveal>
      <SectionLabel index={4} label="Process" rule />
      <h2 id="process-heading" class="mt-6 text-h2 font-semibold">How a project <em>works.</em></h2>
    </div>

    <!-- Vertical timeline on mobile; horizontal with a connecting hairline on lg+. -->
    <ol class="mt-12 grid sm:mt-16 lg:grid-cols-4 lg:gap-8">
      {
        steps.map((step, i) => (
          <li
            class="relative pb-12 pl-10 last:pb-0 lg:row-span-4 lg:grid lg:grid-rows-subgrid lg:gap-0 lg:pt-12 lg:pb-0 lg:pl-0"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="absolute top-0 left-0 grid size-4 place-items-center rounded-full border border-ink bg-paper"
              aria-hidden="true"
            >
              <span class:list={['size-1.5 rounded-full', i === steps.length - 1 ? 'bg-signal' : 'bg-ink']} />
            </span>
            {i < steps.length - 1 && (
              <span
                class="absolute top-4 bottom-0 left-[7.5px] w-px bg-ink/25 lg:top-[7.5px] lg:bottom-auto lg:left-4 lg:-right-8 lg:h-px lg:w-auto"
                aria-hidden="true"
              />
            )}

            <p class="label flex gap-3 text-muted">
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{step.duration}</span>
            </p>
            <h3 class="mt-3 text-h3 font-semibold">{step.title}</h3>
            <p class="mt-3 max-w-md text-pretty text-muted">{step.body}</p>
            <p class="mt-5 max-w-md self-start border-t border-hairline pt-4">
              <span class="label mr-2 text-muted">You get:</span>
              <span class="font-medium">{step.deliverable}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <!-- Client portal preview -->
    <div class="mt-20 grid gap-10 border-t border-hairline pt-16 sm:mt-28 lg:grid-cols-12 lg:items-center lg:gap-8">
      <div class="lg:col-span-5" data-reveal>
        <h3 class="text-h3 font-semibold text-balance lg:text-4xl lg:leading-tight">
          You'll never have to ask <em>'how's it going?'</em>
        </h3>
        <p class="mt-5 max-w-md text-lg text-pretty text-muted">
          Every client gets access to TD Tracker, our project portal. Milestones, progress, and files, all in
          one place.
        </p>
      </div>

      <figure class="lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay: 100ms">
        <figcaption class="sr-only">Example project view in TD Tracker, with sample data.</figcaption>

        <div class="portal border border-ink bg-paper" aria-hidden="true">
          <div class="flex items-center justify-between border-b border-ink px-4 py-3 sm:px-5">
            <span class="label flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-signal"></span>
              TD Tracker
            </span>
            <span class="label text-muted">Sample</span>
          </div>

          <div class="px-4 py-5 sm:px-5 sm:py-6">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="label text-muted">Project</p>
                <p class="mt-1 text-xl font-semibold tracking-tight">Your project</p>
              </div>
              <p class="font-mono text-2xl tabular-nums">{overall}%</p>
            </div>
            <div class="mt-3 h-1.5 bg-hairline">
              <div class="bar h-full bg-ink" style={`width: ${overall}%`}></div>
            </div>

            <ul class="mt-6 divide-y divide-hairline border-y border-hairline">
              {
                milestones.map((m, i) => (
                  <li class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 py-3.5">
                    <span class="flex items-baseline gap-3">
                      <span class="label text-muted">{String(i + 1).padStart(2, '0')}</span>
                      <span class:list={['font-medium', m.status === 'next' && 'text-muted']}>{m.name}</span>
                    </span>

                    {m.status === 'done' && (
                      <span class="label border border-ink px-1.5 py-0.5">✓ Done</span>
                    )}
                    {m.status === 'progress' && (
                      <span class="label flex items-center gap-1.5 bg-ink px-1.5 py-0.5 text-paper">
                        <span class="relative flex size-1.5">
                          <span class="absolute inset-0 rounded-full bg-signal motion-safe:animate-status-pulse" />
                          <span class="relative size-1.5 rounded-full bg-signal" />
                        </span>
                        In progress
                      </span>
                    )}
                    {m.status === 'next' && (
                      <span class="label border border-dashed border-muted/50 px-1.5 py-0.5 text-muted">Up next</span>
                    )}

                    <span class="col-span-2 flex items-center gap-3">
                      <span class="h-1 flex-1 bg-hairline">
                        <span
                          class:list={['bar block h-full', m.status === 'progress' ? 'bg-signal' : 'bg-ink']}
                          style={`width: ${m.percent}%; --bar-delay: ${300 + i * 120}ms`}
                        />
                      </span>
                      <span class="w-9 text-right font-mono text-xs text-muted tabular-nums">{m.percent}%</span>
                    </span>
                  </li>
                ))
              }
            </ul>

            <div class="mt-5 flex flex-wrap items-center gap-2">
              <span class="label mr-1 text-muted">Files</span>
              {files.map((file) => <span class="border border-hairline px-2 py-0.5 font-mono text-xs">{file}</span>)}
            </div>
          </div>

          <p class="label border-t border-hairline px-4 py-3 text-muted sm:px-5">Last updated · Today, 4:12 PM</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Progress bars fill in when the portal scrolls into view. */
  .bar {
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms var(--ease-out-quart) var(--bar-delay, 200ms);
    }

    :global(.js) :global([data-reveal]:not(.is-visible)) .bar {
      transform: scaleX(0);
    }
  }
</style>
