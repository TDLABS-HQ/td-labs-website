---
import ArrowLink from '../ArrowLink.astro';
import BrowserFrame from '../BrowserFrame.astro';
import Button from '../Button.astro';
import DotList from '../DotList.astro';
import Screen from '../Screen.astro';
import SectionLabel from '../SectionLabel.astro';

/*
 * [PLACEHOLDER screenshot] To use the real featured project:
 *   1. Save it as src/assets/hero/featured.png (any aspect ratio works)
 *   2. import featured from '../../assets/hero/featured.png';
 *   3. const screenshot = { src: featured, alt: 'Describe what the screenshot shows' };
 * Then adjust each note's x/y (percent of the screenshot) to point at the right spot.
 */
const screenshot = null as { src: ImageMetadata; alt: string } | null;

const notes = [
  { text: '→ Orders paid via GCash', x: 34, y: 22 },
  { text: '→ Mobile-first menu', x: 62, y: 46 },
  { text: '→ Owner updates prices in seconds', x: 44, y: 70 },
];

const industries = ['RESTAURANTS', 'CLINICS', 'HOTELS', 'RETAIL', 'STARTUPS'];
---

<section aria-labelledby="hero-heading" class="relative overflow-x-clip border-b border-hairline pt-nav">
  <div
    class="shell grid gap-14 pt-10 pb-16 sm:pt-16 sm:pb-20 lg:grid-cols-12 lg:items-center lg:gap-8 lg:pt-20 lg:pb-28"
  >
    <div class="lg:col-span-6">
      <SectionLabel index={0} label="Technology & Design Labs" />

      <h1
        id="hero-heading"
        class="mt-6 text-display font-semibold text-balance lg:text-[4rem] xl:text-[4.75rem]"
      >
        We design and build the software your business <em>runs on.</em>
      </h1>

      <p class="mt-6 max-w-xl text-lg text-pretty text-muted sm:text-xl">
        Websites, booking systems, and custom business tools for startups and small businesses —
        thoughtfully designed, properly engineered, and built around how you actually work.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5">
        <Button href="/start">Start a Project</Button>
        <ArrowLink href="#work" arrow="↓">See our work</ArrowLink>
      </div>

<DotList items={industries} class="mt-12 text-muted" aria-label="Industries we work with" />
    </div>

    <!-- Lab specimen: featured project in a browser frame with notebook annotations. -->
    <figure class="max-w-xl lg:col-span-6 lg:max-w-none lg:pr-40 xl:pr-44">
      <BrowserFrame>
        <Screen
          image={screenshot ?? undefined}
          aspect="aspect-[4/3]"
          sizes="(min-width: 1280px) 420px, (min-width: 1024px) 34vw, (min-width: 640px) 576px, 100vw"
          loading="eager"
        />

          <!-- Markers; on lg+ each extends a leader line to its note in the right gutter. -->
          {
            notes.map((note, i) => (
              <div
                class="absolute flex -translate-y-1/2 items-center lg:-right-40 xl:-right-44"
                style={`left: ${note.x}%; top: ${note.y}%;`}
                aria-hidden="true"
              >
                <span class="-ml-2.5 grid size-5 shrink-0 place-items-center rounded-full bg-ink font-mono text-[10px] text-paper ring-4 ring-paper">
                  {i + 1}
                </span>
                <span
                  class="hidden h-px flex-1 origin-left bg-ink motion-safe:animate-draw lg:block"
                  style={`animation-delay: ${300 + i * 150}ms;`}
                />
                <span
                  class="hidden w-36 shrink-0 pl-3 font-mono text-xs leading-snug motion-safe:animate-fade-in lg:block xl:w-40"
                  style={`animation-delay: ${650 + i * 150}ms;`}
                >
                  {note.text}
                </span>
              </div>
            ))
          }
      </BrowserFrame>

      <!-- Key for the numbered markers: visible on small screens, read by screen readers everywhere. -->
      <figcaption class="mt-5 lg:sr-only">
        <ol class="grid gap-2 font-mono text-xs">
          {
            notes.map((note, i) => (
              <li class="flex items-center gap-3">
                <span
                  class="grid size-5 shrink-0 place-items-center rounded-full bg-ink text-[10px] text-paper"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {note.text}
              </li>
            ))
          }
        </ol>
      </figcaption>
    </figure>
  </div>
</section>
