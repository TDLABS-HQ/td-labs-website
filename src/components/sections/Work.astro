---
import ArrowLink from '../ArrowLink.astro';
import BrowserFrame from '../BrowserFrame.astro';
import ConceptTag from '../ConceptTag.astro';
import Screen from '../Screen.astro';
import ScreenPair from '../ScreenPair.astro';
import SectionLabel from '../SectionLabel.astro';
import StackTags from '../StackTags.astro';
import { caseStudyUrl, getCaseStudies, metaLine } from '../../lib/case-studies';

const all = await getCaseStudies();
const featured = all.find((entry) => entry.data.kind === 'client' && entry.data.featured);
const concepts = all.filter((entry) => entry.data.kind === 'concept').slice(0, 2);
---

<section id="work" aria-labelledby="work-heading" class="border-b border-hairline py-20 sm:py-28">
  <div class="shell">
    <div data-reveal>
      <SectionLabel index={1} label="Selected work" rule />
      <h2 id="work-heading" class="mt-6 max-w-4xl text-h2 font-semibold text-balance">
        Real businesses. <em>Real problems.</em> Working software.
      </h2>
    </div>

    {
      featured && (
        <article
          class="mt-12 grid border border-ink sm:mt-16 lg:grid-cols-12"
          aria-labelledby={`case-${featured.id}`}
          data-reveal
        >
          <div class="flex flex-col p-6 sm:p-8 lg:col-span-5 lg:p-10">
            <p class="label text-muted">{metaLine(featured.data)}</p>
            <h3 id={`case-${featured.id}`} class="mt-3 text-h3 font-semibold">
              {featured.data.client}
            </h3>

            <dl class="mt-8 divide-y divide-hairline border-y border-hairline">
              <div class="grid gap-1.5 py-4">
                <dt class="label text-muted">The problem</dt>
                <dd class="text-pretty">{featured.data.problem}</dd>
              </div>
              <div class="grid gap-1.5 py-4">
                <dt class="label text-muted">What we built</dt>
                <dd class="text-pretty">{featured.data.built}</dd>
              </div>
              <div class="grid gap-1.5 py-4">
                <dt class="label flex items-center gap-2 text-muted">
                  <span class="size-1.5 rounded-full bg-signal" aria-hidden="true" />
                  The result
                </dt>
                <dd class="text-lg font-medium text-pretty">{featured.data.result}</dd>
              </div>
            </dl>

            <StackTags stack={featured.data.stack} class="mt-6" />

            <div class="mt-8 lg:mt-auto lg:pt-8">
              <ArrowLink href={caseStudyUrl(featured)} srSuffix={featured.data.client}>
                Read the case study
              </ArrowLink>
            </div>
          </div>

          <div class="bg-grid border-t border-ink p-5 sm:p-8 lg:col-span-7 lg:flex lg:items-center lg:border-t-0 lg:border-l lg:p-10">
            <div class="w-full">
              <ScreenPair screens={featured.data.screens} lgWidth="min(40vw, 620px)" />
            </div>
          </div>
        </article>
      )
    }

    {
      concepts.length > 0 && (
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {concepts.map((entry, i) => (
            <article
              class="flex flex-col border border-hairline p-5 sm:p-6"
              aria-labelledby={`case-${entry.id}`}
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <BrowserFrame>
                <Screen
                  image={entry.data.screens.desktop}
                  aspect="aspect-[2/1]"
                  crop
                  placeholder="[PLACEHOLDER desktop]"
                  sizes="(min-width: 1280px) 560px, (min-width: 768px) 45vw, 90vw"
                />
              </BrowserFrame>

              <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
                <ConceptTag />
                <p class="label text-muted">{metaLine(entry.data)}</p>
              </div>
              <h3 id={`case-${entry.id}`} class="mt-4 text-h3 font-semibold">
                {entry.data.client}
              </h3>
              <p class="mt-3 text-pretty text-muted">{entry.data.built}</p>

              <StackTags stack={entry.data.stack} class="mt-5" />

              <div class="mt-6 md:mt-auto md:pt-6">
                <ArrowLink href={caseStudyUrl(entry)} srSuffix={entry.data.client}>
                  Read the case study
                </ArrowLink>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
