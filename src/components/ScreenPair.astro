---
/** Desktop screen in a browser frame beside a mobile screen in a phone frame. */
import type { CaseStudy } from '../lib/case-studies';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import Screen from './Screen.astro';

interface Props {
  screens: CaseStudy['data']['screens'];
  /** Rendered width of the pair at lg+, for responsive image sizes. */
  lgWidth: string;
  loading?: 'eager' | 'lazy';
}

const { screens, lgWidth, loading } = Astro.props;
---

<div class="grid grid-cols-[3fr_1fr] items-end gap-3 sm:gap-5">
  <BrowserFrame>
    <Screen
      image={screens.desktop}
      placeholder="[PLACEHOLDER desktop]"
      sizes={`(min-width: 1024px) calc(${lgWidth} * 0.75), 75vw`}
      loading={loading}
    />
  </BrowserFrame>
  <PhoneFrame>
    <Screen
      image={screens.mobile}
      aspect="aspect-[9/19]"
      placeholder="[PLACEHOLDER mobile]"
      sizes={`(min-width: 1024px) calc(${lgWidth} * 0.25), 25vw`}
      widths={[160, 320, 480, 640]}
      loading={loading}
    />
  </PhoneFrame>
</div>
